  "description": "Vào tuoitre.vn, tìm bài viết mới nhất trên trang chủ và lấy nội dung chi tiết.",
  "category": "scraping",
  "target_url": "https://tuoitre.vn",
  "tags": [],
  "steps": [
    {
      "type": "navigate",
      "label": "Đi đến tuoitre.vn",
