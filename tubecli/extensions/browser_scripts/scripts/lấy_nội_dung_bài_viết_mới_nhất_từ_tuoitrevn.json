      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "wait",
      "label": "Chờ trang chủ tải xong",
      "selector": "body",
      "params": {
        "state": "visible",
        "timeout": 15000
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "sleep",
      "label": "Đọc trang chủ",
      "selector": "",
      "params": {
        "ms": 3000
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "scroll",
      "label": "Cuộn nhẹ xuống để thấy bài viết mới",
      "selector": "",
      "params": {
        "direction": "down",
        "amount": 400
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "sleep",
      "label": "Dừng một chút",
