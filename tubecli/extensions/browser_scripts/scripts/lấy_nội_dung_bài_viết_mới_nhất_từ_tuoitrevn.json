      "selector": "article a[href]:first-of-type",
      "params": {
        "attribute": "href",
        "save_as": "first_article_url"
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "hover",
      "label": "Di chuột đến link bài viết đầu tiên",
      "selector": "article a[href]:first-of-type",
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "sleep",
      "label": "Chờ trước khi click",
      "selector": "",
      "params": {
        "ms": 600
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "click",
      "label": "Click vào bài viết đầu tiên",
      "selector": "article a[href]:first-of-type",
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "wait",
      "label": "Chờ trang bài viết tải",
      "selector": "article, .detail-content, .content-detail, main",
      "params": {
        "state": "visible",
        "timeout": 15000
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "sleep",
      "label": "Đọc bài viết",
      "selector": "",
      "params": {
        "ms": 3000
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "scroll",
      "label": "Cuộn xuống để lấy nội dung",
