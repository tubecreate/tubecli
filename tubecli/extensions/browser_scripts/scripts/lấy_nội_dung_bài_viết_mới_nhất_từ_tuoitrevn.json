        "amount": 500
      },
      "enabled": true,
      "on_error": "abort",
      "retry_count": 0
    },
    {
      "type": "sleep",
      "label": "Chờ nội dung hiện ra",
      "selector": "",
      "params": {
        "ms": 2000
